rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Only authenticated admin can list all visitor uploads
    // Public visitors can only upload images up to 5MB to their own participant folder
    match /visitor_uploads/{participantId}/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      // Admin can read all; public cannot enumerate all buckets
      allow read: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
