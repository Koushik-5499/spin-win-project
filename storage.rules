rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Visitor image uploads folder
    match /visitor_uploads/{participantId}/{fileName} {
      // Allow visitor upload if file is under 5MB and has valid image MIME type
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      // Allow public get so getDownloadURL resolves for the confirmed image,
      // while restricting bucket/directory listing to authenticated admins only.
      allow get: if true;
      allow list: if request.auth != null;
    }

    // Default: Authenticated admin only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
