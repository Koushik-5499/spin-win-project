# Firebase Web App Public Configuration
# Retrieve these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=AIzaSyAEXAMPLE_KEY_REPLACE_WITH_YOURS
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Note: In pure client-side HTML/JS, credentials in js/firebase-config.js identify your Firebase project.
# Security is enforced server-side using firestore.rules and storage.rules!
